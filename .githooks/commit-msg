#!/usr/bin/env sh
# Local mirror of the commit-conventions CI check: fails a commit whose
# message is not a Conventional Commit before it ever reaches a pull request.
# CI (commitlint with config-conventional) remains the authority; this hook
# checks the common failures fast and offline. Activated by `npm install`,
# whose prepare script points core.hooksPath here.
# Synced from the trainer-engine repo; do not edit in an app repo.

msg_file="$1"
subject=$(sed -n '1p' "$msg_file")

# Merges, reverts of merges, and fixup/squash commits are git-generated and
# get rewritten or dropped before they reach main.
case "$subject" in
  Merge\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
if ! printf '%s' "$subject" | grep -qE "^($types)(\([^)]+\))?!?: .+"; then
  echo "commit-msg: not a Conventional Commit subject:" >&2
  echo "  $subject" >&2
  echo "expected: <type>[(scope)][!]: <description>, e.g." >&2
  echo "  fix: clamp the review interval to the exam date" >&2
  echo "types: ${types}" >&2
  echo "(see the commits and releases section of CONTRIBUTING.md)" >&2
  exit 1
fi

if [ "$(printf '%s' "$subject" | wc -c)" -gt 100 ]; then
  echo "commit-msg: subject is over 100 characters, which commitlint rejects" >&2
  exit 1
fi

# config-conventional wants the body separated from the subject by one blank
# line; catch the classic `git commit -m a -m`-less mistake early.
second=$(sed -n '2p' "$msg_file")
if [ -n "$second" ] && ! printf '%s' "$second" | grep -q '^#'; then
  echo "commit-msg: put a blank line between the subject and the body" >&2
  exit 1
fi

exit 0
